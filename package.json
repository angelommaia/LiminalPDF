    "@tauri-apps/plugin-dialog": "^2.8.3",
    "pdfjs-dist": "^4.10.38"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.12.3",
    "opentype.js": "^1.3.4",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
