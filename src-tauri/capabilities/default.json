{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões das janelas. Acesso a arquivos passa só pelos comandos do próprio app (read_pdf, read_marks, write_marks, write_pdf), que aceitam apenas .pdf e .json.",
  "windows": ["main", "merge"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-destroy",
    "core:webview:allow-create-webview-window",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message"
  ]
}
